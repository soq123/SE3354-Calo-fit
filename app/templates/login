{% extends "base.html" %}
{% block title %}Login | CaloFit{% endblock %}
{% block content %}
<div class="row justify-content-center align-items-center min-vh-70">
    <div class="col-md-8 col-lg-5">
        <div class="card calofit-card auth-card">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <h1 class="page-title mb-2">Welcome back</h1>
                    <p class="text-muted mb-0">Log in to track calories, mood, and weekly nutrition trends.</p>
                </div>
                <form method="POST" action="{{ url_for('auth.login') }}">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="email">Email</label>
                        <input class="form-control" type="email" id="email" name="email" value="{{ email or '' }}" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="password">Password</label>
                        <input class="form-control" type="password" id="password" name="password" required>
                    </div>
                    <button class="btn btn-success w-100" type="submit">Log In</button>
                </form>
                <p class="small text-muted mt-4 mb-0 text-center">No account yet? <a href="{{ url_for('auth.register') }}">Create one</a></p>
                <p class="small text-muted mt-2 mb-0 text-center">Demo login: demo@calofit.com / demo123</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
